<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Rfx2Mqtt</RootNamespace>
    <AssemblyName>Rfx2Mqtt</AssemblyName>
    <Version>1.1.0</Version>
    <Company>Chriss-Consulting</Company>
    <Copyright>© $([System.DateTime]::UtcNow.Year) Chriss-Consulting</Copyright>
    <Product>Rfx2Mqtt</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Date de build, exposée via AppInfo.ReleaseDate (évaluée à la compilation) -->
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="MudBlazor" Version="9.7.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.10" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rfx2Mqtt.Tests" />
  </ItemGroup>

</Project>
